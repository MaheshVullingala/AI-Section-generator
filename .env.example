# Copy to .env.local and fill in. Never commit real keys.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# CLAUDE_GENERATE_MODEL=claude-opus-5-5
# CLAUDE_REFINE_MODEL=claude-opus-5-5
# CLAUDE_GENERATE_EFFORT=medium   # low | medium | high | xhigh | max
# CLAUDE_REFINE_EFFORT=medium

# Shared storage + sign-in (optional). Uses content-intake's Supabase project, so
# people sign in with their content-intake account. Leave blank to keep data in this browser only.
# NEXT_PUBLIC_SUPABASE_URL=https://izhfetvnortpjimfwnad.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   (NEXT_PUBLIC_SUPABASE_ANON_KEY also works)
# The service role key is not used by this app; leave it out.

# Without the Supabase variables a production build refuses Claude requests, so a public
# URL can't spend credits. Set this only for a private, trusted deployment.
# ALLOW_NO_AUTH=true
